# Managed by Ansible - edits will be overwritten.

{
    email {{ acme_email }}
    # No HTTP listener: DNS-01 means we never need port 80.
    auto_https disable_redirects
}

{{ guac_domain }} {

    tls {
        # DNS-01 challenge via Cloudflare - port 80 is never used.
        dns cloudflare {env.CF_API_TOKEN}
        }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
    redir / /guacamole/ permanent

    reverse_proxy 127.0.0.1:{{ guac_listen_port }} {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Guacamole tunnels over WebSocket; keep it patient.
        transport http {
            read_timeout 3600s
            write_timeout 3600s
        }
    }

}
